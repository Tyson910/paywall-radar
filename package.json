{
  "name": "paywall-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./dist/shared/*"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -b shared/tsconfig.build.json server/tsconfig.build.json && cp -R server/src/database/migrations dist/server/database/migrations",
    "build:client": "vite build --config client/vite.config.ts",
    "clean": "tsc -b --clean && rm -rf dist",
    "dev": "tsx watch --env-file=.env server/src/dev.ts",
    "dev:server": "tsx watch --env-file=.env server/src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:init": "tsx --env-file=.env server/src/scripts/initialize-database.ts",
    "labeler:setup": "tsx --env-file=.env server/src/scripts/setup-labeler.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . && pnpm format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p client/tsconfig.json",
    "dev:client": "vite dev --config client/vite.config.ts"
  },
  "dependencies": {
    "@atproto/crypto": "^0.5.4",
    "@atproto/lex-cbor": "^0.1.4",
    "@hono/node-server": "^2.0.12",
    "@libsql/client": "0.17.4",
    "drizzle-orm": "0.45.2",
    "hono": "^4.12.32",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "0.31.10",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.1.5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.14.0"
}
