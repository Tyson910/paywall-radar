{
  "name": "paywall-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./dist/shared/*"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -b shared/tsconfig.build.json server/tsconfig.build.json && cp -R server/src/database/migrations dist/server/database/migrations",
    "clean": "tsc -b --clean && rm -rf dist",
    "dev": "tsx watch server/src/index.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:init": "tsx server/src/scripts/initialize-database.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "@skyware/labeler": "0.2.0",
    "drizzle-orm": "0.45.2",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.14.0"
}
