{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "exactOptionalPropertyTypes": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noUncheckedIndexedAccess": true,
    "outDir": "../dist/shared",
    "rootDir": ".",
    "strict": true,
    "target": "ES2023"
  },
  "include": ["*.ts"]
}
