PORT=4100
DB_PATH=./data/paywall-radar.db

# S3 replication
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LITESTREAM_REPLICA_URL=s3://mybucket/db?endpoint=s3.us-west-1.wasabisys.com

DID=
SIGNING_KEY=
CLIENT_DIR=dist/client

# Admin authentication
ADMIN_DID=
PUBLIC_URL=http://127.0.0.1:4100
SESSION_SECRET=
# Required when PUBLIC_URL is not a loopback URL
OAUTH_PRIVATE_KEY=
